# Dependencies
/api-server/node_modules/
/frontend/node_modules/

# Build outputs
/api-server/dist/
/api-server/build/
/frontend/dist/
/frontend/build/

# Terraform
/shopeasy-terraform/.terraform/
/shopeasy-terraform/*.tfstate
/shopeasy-terraform/*.tfstate.backup
/shopeasy-terraform/*.tfvars
!/shopeasy-terraform/*.tfvars.example
/shopeasy-terraform/.terraform.lock.hcl

# Environment files
/api-server/.env
/frontend/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
!.env.example
!**/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS temporary files
.DS_Store
Thumbs.db
Desktop.ini

# Uploads
/api-server/uploads/*

# Keep lockfiles
!package-lock.json
!**/package-lock.json